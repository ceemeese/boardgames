{
    "name": "boardgames-backend",
    "version": "0.1",
    "description": "Boardgames application",
    "scripts": {
        "unit-test": "jest --coverage --verbose src/test/unit",
        "integration-test": "NODE_ENV=local nyc --report-dir=coverage-nyc mocha src/test/integration --timeout 20000 --exit",
        "coverage:report": "nyc report --reporter=lcov --report-dir=coverage-nyc",
        "coverage:merge": "lcov-result-merger 'coverage-*/lcov.info' > coverage/lcov.info",
        "test": "npm run unit-test && npm run integration-test",
        "start": "node src/app.js",
        "start-dev": "node src/app.js --config config.local.yaml",
        "start-prod": "node src/app.js --config config.prod.yaml",
        "database:test": "docker compose -f ./docker-compose.dev.yaml up -d",
        "database:down": "docker compose -f ./docker-compose.dev.yaml down"
    },
    "author": "Cristina Malmierca",
    "license": "GPL-2.0-only",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.840.0",
        "@aws-sdk/s3-request-presigner": "^3.844.0",
        "cors": "^2.8.5",
        "dotenv": "^17.0.1",
        "express": "^4.21.1",
        "express-validator": "^7.2.1",
        "js-yaml": "^4.1.0",
        "knex": "3.1.0",
        "multer": "^2.0.1",
        "mysql": "^2.18.1",
        "prom-client": "^15.1.3",
        "sharp": "^0.34.3",
        "yargs": "^17.7.2"
    },
    "devDependencies": {
        "babel-eslint": "^10.1.0",
        "chai": "^4.4.1",
        "chai-http": "^4.4.0",
        "jest": "^29.7.0",
        "lcov-result-merger": "^5.0.1",
        "mocha": "^10.4.0",
        "nyc": "^17.1.0",
        "sinon": "^21.0.0",
        "supertest": "^7.1.1"
    },
    "eslintConfig": {
        "env": {
            "jest": true
        }
    },
    "nyc": {
        "reporter": [
            "lcov",
            "text"
        ],
        "all": true,
        "include": [
            "src/**/*.js"
        ],
        "exclude": [
            "test/**/*.js",
            "package.json",
            "**/*.config.js",
            "**/*.json",
            "node_modules",
            "db",
            "**/src/test/**"
        ]
    },
    "jest": {
        "collectCoverage": true,
        "collectCoverageFrom": [
        "src/**/*.{js,ts,tsx}",
        "!**/node_modules/**",
        "!**/package.json",
        "!**/*.config.js",
        "!**/*.json",
        "!**/db/*.sql",
        "!**/src/config/**",
        "!**/src/utils/**",
        "!**/src/route/**",
        "!**/src/validators/**",
        "!**/src/middleware/**",
        "!**/src/app"
        ],
        "coveragePathIgnorePatterns": [
            "/node_modules/",
            "package.json",
            "\\.json$"
        ]
    }
}
