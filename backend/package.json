{
    "name": "boardgames-backend",
    "version": "0.1",
    "description": "Boardgames application",
    "scripts": {
        "unit-test": "jest --verbose src/test/unit",
        "integration-test": "NODE_ENV=local mocha src/test/integration --exit",
        "test": "npm run unit-test && npm run integration-test",
        "start": "node src/app.js",
        "start-dev": "node src/app.js --config config.local.yaml",
        "start-prod": "node src/app.js --config config.prod.yaml",
        "database:test": "docker compose -f ./docker-compose.dev.yaml up -d",
        "database:down": "docker compose -f ./docker-compose.dev.yaml down"
    },
    "author": "Cristina Malmierca",
    "license": "GPL-2.0-only",
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^4.21.1",
        "express-validator": "^7.2.1",
        "js-yaml": "^4.1.0",
        "knex": "3.1.0",
        "mysql": "^2.18.1",
        "yargs": "^17.7.2"
    },
    "devDependencies": {
        "babel-eslint": "^10.1.0",
        "chai": "^4.4.1",
        "chai-http": "^4.4.0",
        "jest": "^29.7.0",
        "mocha": "^10.4.0",
        "supertest": "^7.1.1"
    },
    "eslintConfig": {
        "env": {
            "jest": true
        }
    }
}
